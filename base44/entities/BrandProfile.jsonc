{
  "name": "BrandProfile",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Company or practice name"
    },
    "product_description": {
      "type": "string",
      "description": "What the business does / sells, in plain language"
    },
    "target_audience": {
      "type": "string",
      "description": "Who the content is aimed at (demographics, location, needs)"
    },
    "voice_guidelines": {
      "type": "string",
      "description": "Tone, personality, and style rules for the brand voice"
    },
    "product_facts": {
      "type": "string",
      "description": "Key facts, features, pricing, and differentiators to reference"
    },
    "banned_claims": {
      "type": "string",
      "description": "Claims, phrases, or promises that must never appear in content"
    },
    "internal_links": {
      "type": "string",
      "description": "Site pages and anchor text to use for internal linking"
    },
    "style_examples": {
      "type": "string",
      "description": "Sample copy or reference posts that capture the desired style"
    },
    "brand_assets": {
      "type": "array",
      "description": "Uploaded brand images (logos, badges, overlays) with usage instructions, applied as overlays when a post reaches the approved step",
      "items": {
        "type": "object",
        "properties": {
          "file_url": {
            "type": "string",
            "description": "Uploaded image URL"
          },
          "label": {
            "type": "string",
            "description": "What this image is (e.g. 'Primary logo', 'Corner badge')"
          },
          "instructions": {
            "type": "string",
            "description": "How this image should be used as an overlay (placement, size, opacity, when to apply)"
          }
        },
        "required": [
          "file_url"
        ]
      },
      "default": []
    }
  },
  "required": [
    "company_name"
  ]
}